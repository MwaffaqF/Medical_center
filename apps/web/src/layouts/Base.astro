---
import { localeDir, t, type Locale } from "@mc/shared";
import "../styles.css";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}
const { locale, title, description } = Astro.props;
const other: Locale = locale === "ar" ? "en" : "ar";
// Same page in the other language: swap the first path segment.
const otherPath = Astro.url.pathname.replace(/^\/(ar|en)(?=\/|$)/, `/${other}`);
const pageTitle = title ? `${title} | ${t(locale, "app.name")}` : t(locale, "app.name");
---

<!doctype html>
<html lang={locale} dir={localeDir(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0f766e" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang={locale} href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang={other} href={new URL(otherPath, Astro.site)} />
  </head>
  <body class="min-h-dvh bg-white font-sans text-slate-900 antialiased">
    <header class="border-b border-slate-100">
      <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3">
        <a href={`/${locale}/`} class="flex items-center gap-2 font-semibold">
          <img src="/icon.svg" alt="" class="size-8" />
          {t(locale, "app.name")}
        </a>
        <a href={otherPath} hreflang={other} class="rounded-md px-3 py-1.5 text-sm font-medium text-brand-700 hover:bg-brand-50">
          {t(locale, "common.switchLanguage")}
        </a>
      </div>
    </header>
    <slot />
  </body>
</html>
