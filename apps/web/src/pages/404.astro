---
import "../styles.css";

Astro.response.status = 404;
const ar = !Astro.url.pathname.startsWith("/en");
---

<!doctype html>
<html lang={ar ? "ar" : "en"} dir={ar ? "rtl" : "ltr"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{ar ? "الصفحة غير موجودة" : "Page not found"}</title>
    <link rel="icon" href="/icon.svg" />
  </head>
  <body class="flex min-h-dvh items-center justify-center bg-slate-50 px-4 font-sans text-slate-900">
    <main class="max-w-md text-center">
      <p class="text-6xl font-extrabold text-brand-700">404</p>
      <h1 class="mt-4 text-2xl font-bold">{ar ? "الصفحة غير موجودة" : "Page not found"}</h1>
      <p class="mt-2 text-slate-600">{ar ? "الصفحة التي تبحث عنها غير موجودة." : "The page you are looking for does not exist."}</p>
      <a href={ar ? "/ar/" : "/en/"} class="mt-6 inline-block rounded-xl bg-brand-700 px-6 py-3 font-semibold text-white">
        {ar ? "الذهاب إلى الصفحة الرئيسية" : "Go to the home page"}
      </a>
    </main>
  </body>
</html>
