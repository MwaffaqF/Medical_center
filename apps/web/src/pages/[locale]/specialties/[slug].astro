---
import DoctorCard from "../../../components/DoctorCard.astro";
import Icon from "../../../components/Icon.astro";
import Base from "../../../layouts/Base.astro";
import { pick, t } from "../../../i18n";
import { getSite } from "../../../lib/api";
import { localeParam } from "../../../lib/page";
import { specialtyIcon } from "../../../lib/specialty-icon";

const locale = localeParam(Astro.params.locale);
if (!locale) return Astro.rewrite("/404");
const site = await getSite();
const specialty = site.specialties.find((s) => s.slug === Astro.params.slug);
if (!specialty) return Astro.rewrite("/404");
const name = pick(locale, specialty.nameAr, specialty.nameEn);
const description = pick(locale, specialty.descriptionAr, specialty.descriptionEn);
const doctors = site.doctors.filter((d) => d.specialtyIds.includes(specialty.id));
Astro.response.headers.set("Cache-Control", "public, max-age=60");
---

<Base locale={locale} site={site} title={name} description={description || undefined}>
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <a href={`/${locale}/specialties`} class="text-sm font-medium text-brand-700 hover:underline">{t(locale, "specialties.all")}</a>
      <div class="mt-3 flex items-center gap-4">
        <span class="flex size-14 items-center justify-center rounded-2xl bg-brand-700 text-white">
          <Icon name={specialtyIcon(specialty) as never} class="size-7" />
        </span>
        <h1 class="text-3xl font-bold">{name}</h1>
      </div>
      {description && <p class="mt-4 max-w-3xl whitespace-pre-line text-lg text-slate-700">{description}</p>}
    </div>
  </section>
  <div class="mx-auto max-w-6xl px-4 py-10">
    <h2 class="mb-6 text-xl font-semibold">{t(locale, "specialties.doctorsIn", { name })}</h2>
    {
      doctors.length ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {doctors.map((d) => (
            <DoctorCard locale={locale} doctor={d} specialties={site.specialties} currency={site.center.currency} />
          ))}
        </div>
      ) : (
        <p class="text-slate-500">{t(locale, "doctors.none")}</p>
      )
    }
  </div>
</Base>
