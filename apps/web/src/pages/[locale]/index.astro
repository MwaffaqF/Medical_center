---
import { LOCALES, t, type Locale } from "@mc/shared";
import Base from "../../layouts/Base.astro";

const locale = Astro.params.locale as Locale;
if (!LOCALES.includes(locale)) return new Response(null, { status: 404 });

// Placeholder home page. Specialties, doctors and booking arrive in milestone M3.
---

<Base locale={locale} description={t(locale, "web.hero.subtitle")}>
  <main>
    <section class="bg-gradient-to-b from-brand-50 to-white">
      <div class="mx-auto max-w-5xl px-4 py-16 sm:py-24">
        <h1 class="max-w-2xl text-3xl font-bold leading-tight sm:text-5xl">{t(locale, "web.hero.title")}</h1>
        <p class="mt-4 max-w-xl text-lg text-slate-600">{t(locale, "web.hero.subtitle")}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <span class="inline-flex items-center rounded-xl bg-brand-700 px-5 py-3 font-semibold text-white opacity-60">
            {t(locale, "web.cta.book")}
          </span>
        </div>
        <p class="mt-3 text-sm text-slate-500">{t(locale, "web.comingSoon")}</p>
      </div>
    </section>
  </main>
</Base>
