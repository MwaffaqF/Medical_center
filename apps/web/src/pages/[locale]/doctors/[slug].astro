---
import DoctorAvatar from "../../../components/DoctorAvatar.astro";
import Icon from "../../../components/Icon.astro";
import Base from "../../../layouts/Base.astro";
import { formatPrice, pick, t } from "../../../i18n";
import { getSite } from "../../../lib/api";
import { localeParam } from "../../../lib/page";

const locale = localeParam(Astro.params.locale);
if (!locale) return Astro.rewrite("/404");
const site = await getSite();
const doctor = site.doctors.find((d) => d.slug === Astro.params.slug);
if (!doctor) return Astro.rewrite("/404");

const name = pick(locale, doctor.nameAr, doctor.nameEn);
const title = pick(locale, doctor.titleAr, doctor.titleEn);
const bio = pick(locale, doctor.bioAr, doctor.bioEn);
const qualifications = pick(locale, doctor.qualificationsAr, doctor.qualificationsEn);
const specs = site.specialties.filter((s) => doctor.specialtyIds.includes(s.id));
const languageNames = new Intl.DisplayNames([locale], { type: "language" });
const languages = doctor.languages.map((l) => {
  try {
    return languageNames.of(l) ?? l;
  } catch {
    return l;
  }
});
const canBook = site.center.status === "active" && doctor.services.length > 0;
Astro.response.headers.set("Cache-Control", "public, max-age=60");

// Structured data for search engines.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name,
  medicalSpecialty: specs.map((s) => s.nameEn),
  ...(title ? { description: title } : {}),
  worksFor: { "@type": "MedicalClinic", name: pick(locale, site.center.nameAr, site.center.nameEn) },
};
---

<Base locale={locale} site={site} title={name} description={title || bio.slice(0, 150) || undefined}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 text-center sm:flex-row sm:text-start">
      <DoctorAvatar url={doctor.photoUrl} name={name} size="size-36" eager />
      <div class="min-w-0">
        <h1 class="text-3xl font-bold">{name}</h1>
        {title && <p class="mt-1 text-lg text-slate-600">{title}</p>}
        <div class="mt-3 flex flex-wrap justify-center gap-2 sm:justify-start">
          {
            specs.map((s) => (
              <a href={`/${locale}/specialties/${s.slug}`} class="rounded-full bg-brand-100 px-3 py-1 text-sm font-medium text-brand-800 hover:bg-brand-200">
                {pick(locale, s.nameAr, s.nameEn)}
              </a>
            ))
          }
        </div>
        {
          canBook && (
            <a href={`/${locale}/book/${doctor.slug}`} class="mt-5 inline-flex items-center gap-2 rounded-xl bg-brand-700 px-6 py-3 font-semibold text-white hover:bg-brand-800">
              <Icon name="calendar" />
              {t(locale, "hero.book")}
            </a>
          )
        }
      </div>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-6">
      {
        bio && (
          <section class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
            <h2 class="mb-3 text-lg font-semibold">{t(locale, "doctors.about")}</h2>
            <p class="whitespace-pre-line leading-relaxed text-slate-700">{bio}</p>
          </section>
        )
      }
      {
        qualifications && (
          <section class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
            <h2 class="mb-3 text-lg font-semibold">{t(locale, "doctors.qualifications")}</h2>
            <p class="whitespace-pre-line leading-relaxed text-slate-700">{qualifications}</p>
          </section>
        )
      }
      {
        (languages.length > 0 || doctor.yearsExperience) && (
          <section class="flex flex-wrap gap-x-8 gap-y-3 rounded-2xl bg-white p-6 ring-1 ring-slate-200">
            {doctor.yearsExperience ? <p class="font-medium">{t(locale, "doctors.experience", { n: doctor.yearsExperience })}</p> : null}
            {languages.length > 0 && (
              <p>
                <span class="text-slate-500">{t(locale, "doctors.languages")}: </span>
                <span class="font-medium">{languages.join(locale === "ar" ? "، " : ", ")}</span>
              </p>
            )}
          </section>
        )
      }
    </div>

    <aside class="h-fit rounded-2xl bg-white p-6 ring-1 ring-slate-200 lg:sticky lg:top-24">
      <h2 class="mb-4 text-lg font-semibold">{t(locale, "doctors.services")}</h2>
      {
        doctor.services.length ? (
          <>
            <ul class="divide-y divide-slate-100">
              {doctor.services.map((s) => (
                <li class="flex items-center justify-between gap-3 py-3">
                  <span>
                    <span class="block font-medium">{t(locale, `booking.${s.bookingType}`)}</span>
                    <span class="text-sm text-slate-500">{t(locale, "doctors.minutes", { n: s.durationMinutes })}</span>
                  </span>
                  <span class="font-semibold">{formatPrice(locale, s.price, site.center.currency)}</span>
                </li>
              ))}
            </ul>
            <p class="mt-3 text-sm text-slate-500">{t(locale, "doctors.servicesNote")}</p>
            {canBook && (
              <a href={`/${locale}/book/${doctor.slug}`} class="mt-4 flex justify-center rounded-xl bg-brand-700 px-4 py-3 font-semibold text-white hover:bg-brand-800">
                {t(locale, "hero.book")}
              </a>
            )}
          </>
        ) : (
          <p class="text-slate-600">{t(locale, "doctors.noServices")}</p>
        )
      }
    </aside>
  </div>
</Base>
