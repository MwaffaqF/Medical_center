{
  "name": "@mc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed.ts --local --dev-data"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@mc/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.13.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261101.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.8",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.160.0"
  }
}
